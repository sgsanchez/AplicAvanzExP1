# =====================================================================
# TurnoConnect - Variables de entorno de EJEMPLO
# Copiar este archivo como ".env" y ajustar los valores.
# NUNCA subir el archivo ".env" real al repositorio.
# =====================================================================

# --- Servidor HTTP / WebSocket (REST + Socket.IO) ---
PORT=3000
HOST=0.0.0.0

# --- Servidores de sockets ---
TCP_PORT=5000
UDP_PORT=5001

# --- Base de datos ---
# Con Docker Compose (recomendado):
MONGODB_URI=mongodb://127.0.0.1:27017/turnoconnect

# --- Seguridad JWT ---
# Generar uno propio con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplazar_por_una_clave_larga_y_aleatoria
JWT_EXPIRES=2h

# --- Datos del estudiante (se muestran en terminal e interfaz) ---
ESTUDIANTE_NOMBRE=SANTIAGO GEOVANNY SANCHEZ CAMACHO
ESTUDIANTE_NRC=37869
