{
  "name": "turnoconnect",
  "version": "1.0.0",
  "description": "TurnoConnect - Sistema distribuido de gestión de turnos con TCP, UDP, WebSockets, REST, JWT y MongoDB",
  "main": "src/server.js",
  "author": "SANTIAGO GEOVANNY SANCHEZ CAMACHO - NRC 37869",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "tcp": "node src/tcp/runTcpServer.js",
    "udp": "node src/udp/runUdpServer.js",
    "cliente:tcp": "node clientes/clienteTCP.js",
    "cliente:udp": "node clientes/clienteUDP.js",
    "seed": "node scripts/seed.js",
    "demo:reset": "node scripts/reset-demo.js",
    "captura": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/capturar-pantalla.ps1",
    "mongo:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mongo-start.ps1",
    "mongo:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mongo-stop.ps1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
